<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WPT.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WPT.WinUI.Controls">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <NavigationView x:Name="NavView"
                        Grid.Row="0"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="TunnelingNavItem" Content="Тунелирование" Tag="0">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProxyNavItem" Content="Прокси" Tag="1">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Link" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProcessModeNavItem" Content="Process Mode" Tag="2">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="SwitchApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BypassNavItem" Content="Zapret + TG" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE13B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Настройки" Tag="4">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Grid x:Name="StatusFooterHost" HorizontalAlignment="Stretch">
                    <controls:StatusIndicatorsControl x:Name="StatusIndicators"
                                                      HorizontalAlignment="Stretch" />
                </Grid>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding FooterLog}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding FooterLog}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding AppVersionLabel}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
