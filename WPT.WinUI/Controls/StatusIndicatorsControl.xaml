<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WPT.WinUI.Controls.StatusIndicatorsControl"
    x:Name="StatusRoot"
    HorizontalAlignment="Stretch"
    SizeChanged="StatusRoot_SizeChanged"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch">
        <StackPanel x:Name="RootPanel" Spacing="6" HorizontalAlignment="Stretch">
            <StackPanel x:Name="TunnelingRow"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding IsTunnelingTabVisible, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="TunnelingDotHost"
                      Width="16"
                      Height="16"
                      Background="Transparent"
                      VerticalAlignment="Center">
                    <Grid Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#FF6B6B6E"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsPacActive, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                        <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsPacActive, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="TunnelingStatusText"
                           Text="{Binding FooterRight}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="ProxyRow"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding IsProxyTabVisible, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="ProxyDotHost"
                      Width="16"
                      Height="16"
                      Background="Transparent"
                      VerticalAlignment="Center">
                    <Grid Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#FF6B6B6E" IsHitTestVisible="False" />
                        <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsProxyHealthy, Converter={StaticResource BoolToVis}}" />
                        <Ellipse Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsProxyUnreachable, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="ProxyStatusText"
                           Text="{Binding FooterProxyStatus}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="ProcessModeRow"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding IsProcessModeTabVisible, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="ProcessModeDotHost"
                      Width="16"
                      Height="16"
                      Background="Transparent"
                      VerticalAlignment="Center">
                    <Grid Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#FF6B6B6E"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsProcessModeRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                        <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsProcessModeRunning, Converter={StaticResource BoolToVis}}" />
                        <Ellipse Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsProcessModeUnreachable, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="ProcessModeStatusText"
                           Text="{Binding FooterProcessModeStatus}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="BypassRow"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{Binding IsBypassTabVisible, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="BypassDotHost"
                      Width="16"
                      Height="16"
                      Background="Transparent"
                      VerticalAlignment="Center">
                    <Grid Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#FF6B6B6E"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsBypassRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" />
                        <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding IsBypassRunning, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
                <TextBlock x:Name="BypassStatusText"
                           Text="{Binding FooterBypassStatus}"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid x:Name="UpdateHost"
                  Margin="0,6,0,0"
                  Visibility="{Binding IsAnyUpdateAvailable, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="UpdateText"
                           Text="Доступны обновления"
                           Style="{StaticResource CaptionText}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Доступны обновления" />
                    </ToolTipService.ToolTip>
                </TextBlock>
                <FontIcon x:Name="UpdateIcon"
                          Glyph="&#xE896;"
                          FontSize="14"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          PointerPressed="UpdateIcon_PointerPressed"
                          ToolTipService.ToolTip="Доступны обновления" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
