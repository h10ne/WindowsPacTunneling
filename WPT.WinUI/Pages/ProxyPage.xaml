<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WPT.WinUI.Pages.ProxyPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:WPT.WinUI.Controls">
    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Сохранённые конфигурации" Style="{StaticResource CaptionText}" />
                    <ctrl:ProxyConfigSelector ItemsSource="{Binding SavedProxyConfigs}"
                                              SelectedItem="{Binding SelectedSavedProxyConfig, Mode=TwoWay}"
                                              DeleteCommand="{Binding DeleteSavedProxyConfigCommand}"
                                              EditingEnabled="{Binding IsProxyEditingEnabled}" />
                </StackPanel>
                <Pivot x:Name="AddConfigPivot"
                       Margin="-12,0,0,0"
                       SelectionChanged="OnAddConfigPivotChanged">
                    <PivotItem Header="Proxy">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Название конфигурации" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding ProxyConfigName, Mode=TwoWay}"
                                         PlaceholderText="Мой сервер" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Строка подключения" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="vless, vmess, trojan или ss" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding ProxyLink, Mode=TwoWay}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="88"
                                         PlaceholderText="vless://uuid@server:443?security=reality&amp;type=tcp#remark" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Сохранить конфигурацию"
                                        Command="{Binding SaveProxyConfigCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="180" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProxyConfigSaveNotice}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           FontSize="12"
                                           Visibility="{Binding HasProxyConfigSaveNotice, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>
                    </PivotItem>
                    <PivotItem Header="VPN">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Название конфигурации" Style="{StaticResource CaptionText}" />
                                <TextBox Text="{Binding VpnConfigName, Mode=TwoWay}"
                                         PlaceholderText="Мой AWG" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Конфигурация AmneziaWG" Style="{StaticResource CaptionText}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1"
                                            Content="Выбрать файл…"
                                            Click="OnPickVpnConfigClick"
                                            IsEnabled="{Binding IsProxyEditingEnabled}"
                                            VerticalAlignment="Stretch" />
                                    <Border x:Name="VpnConfigDropZone"
                                            AllowDrop="True"
                                            DragOver="OnVpnConfigDragOver"
                                            Drop="OnVpnConfigDrop"
                                            Tapped="OnVpnConfigDropZoneTapped"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6"
                                            MinHeight="56">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VpnConfigDropHint}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding IsVpnConfigDropHintVisible, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Visibility="{Binding HasPendingVpnConfig, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding VpnConfigEndpoint, Mode=OneWay}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding VpnConfigSourceName, Mode=OneWay}"
                                                           Style="{StaticResource CaptionText}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Применить конфигурацию"
                                        Command="{Binding SaveVpnConfigCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="180" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding VpnConfigSaveNotice}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                           FontSize="12"
                                           Visibility="{Binding HasVpnConfigSaveNotice, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
                <StackPanel Spacing="4">
                    <TextBlock Text="Локальный порт" Style="{StaticResource CaptionText}" />
                    <TextBox Text="{Binding LocalPort, Mode=TwoWay}"
                             Width="100"
                             HorizontalAlignment="Left"
                             IsEnabled="{Binding IsProxyEditingEnabled}"
                             PlaceholderText="10808" />
                </StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="Локальный прокси не меняет системные настройки. Укажите 127.0.0.1:порт на вкладке «Тунелирование»" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource PageActionBar}">
            <Button Content="{Binding ProxyToggleLabel}"
                    Command="{Binding ToggleProxyCommand}"
                    MinWidth="140"
                    HorizontalAlignment="Left"
                    Style="{StaticResource AccentButtonStyle}" />
        </Border>
    </Grid>
</Page>
