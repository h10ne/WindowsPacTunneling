<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WPT.WinUI.Controls.ProxyConfigSelector"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="36"
    HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <DataTemplate x:Key="ProxyConfigItemTemplate">
            <Grid MinHeight="32" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                <Border Grid.Column="1"
                        Background="{Binding ProtocolColorHex, Converter={StaticResource HexToBrush}}"
                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Protocol}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding PingDisplay}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasPingDisplay, Converter={StaticResource BoolToVis}}" />
                <Button Grid.Column="4"
                        Style="{StaticResource ProxyPingButton}"
                        Click="OnPingClick"
                        Tag="{Binding}"
                        Visibility="{Binding IsPingSupported, Converter={StaticResource BoolToVis}}">
                    <FontIcon Glyph="&#xE945;" FontSize="12" />
                </Button>
                <Button Grid.Column="5"
                        Style="{StaticResource ProxyDeleteButton}"
                        Click="OnDeleteItemClick"
                        Tag="{Binding}">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ComboBox x:Name="ConfigComboBox"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding ItemsSource, ElementName=Root}"
              SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
              ItemTemplate="{StaticResource ProxyConfigItemTemplate}"
              IsEnabled="{Binding EditingEnabled, ElementName=Root}" />
</UserControl>
